{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures:record": "RECORD_GH_FIXTURES=1 vitest run scripts/record-gh-fixtures.test.ts",
    "test:coverage": "vitest run --coverage",
    "e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "idb": "8.0.4",
    "maplibre-gl": "6.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
