{
  "priority": [
    {
      "if": "true",
      "multiply_by": "racingbike_priority"
    },
    {
      "if": "bike_road_access == PRIVATE",
      "multiply_by": "0"
    },
    {
      "if": "mtb_rating > 2",
      "multiply_by": "0"
    },
    {
      "if": "mtb_rating == 2",
      "multiply_by": "0.5"
    },
    {
      "if": "hike_rating > 1",
      "multiply_by": "0"
    },
    {
      "if": "country == DEU && road_class == BRIDLEWAY && bike_road_access != YES",
      "multiply_by": "0"
    },
    {
      "if": "!racingbike_access && (!backward_racingbike_access || roundabout)",
      "multiply_by": "0"
    },
    {
      "else_if": "!racingbike_access && backward_racingbike_access",
      "multiply_by": "0.2"
    }
  ],
  "speed": [
    {
      "if": "true",
      "limit_to": "racingbike_average_speed"
    },
    {
      "if": "!racingbike_access && backward_racingbike_access",
      "limit_to": "5"
    },
    {
      "if": "average_slope >= 15",
      "limit_to": "3"
    },
    {
      "else_if": "average_slope >= 12",
      "limit_to": "6"
    },
    {
      "else_if": "average_slope >=  8",
      "multiply_by": "0.80"
    },
    {
      "else_if": "average_slope >=  4",
      "multiply_by": "0.90"
    },
    {
      "else_if": "average_slope <= -4",
      "multiply_by": "1.10"
    }
  ]
}
