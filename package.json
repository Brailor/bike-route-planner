{
  "name": "bike-route-planner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm run \"/^(dev|routing:start)$/\"",
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm -r --if-present e2e",
    "e2e:live": "pnpm -r --if-present e2e:live",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "routing:setup": "services/routing/scripts/setup.sh",
    "routing:start": "services/routing/scripts/start.sh",
    "routing:image": "docker build -t bike-route-planner-routing services/routing",
    "web:image": "docker build -f apps/web/Dockerfile -t bike-route-planner-web .",
    "containers:up": "docker compose up --build",
    "user:add": "docker compose run --rm api node src/cli.ts add"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
